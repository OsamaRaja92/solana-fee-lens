{
  "name": "solana-fee-lens",
  "version": "0.1.0",
  "description": "Work out what a Solana transaction actually paid to land: base fee, priority fee and tips, correct across legacy, v0 and v1 transactions.",
  "license": "MIT",
  "keywords": [
    "solana",
    "fees",
    "priority-fee",
    "compute-budget",
    "transaction-v1",
    "simd-0385",
    "jito",
    "tips",
    "mev",
    "cli"
  ],
  "author": "Osama Raja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OsamaRaja92/solana-fee-lens.git"
  },
  "homepage": "https://github.com/OsamaRaja92/solana-fee-lens#readme",
  "bugs": {
    "url": "https://github.com/OsamaRaja92/solana-fee-lens/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "bin": {
    "fee-lens": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@solana/kit": "^8.5.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
